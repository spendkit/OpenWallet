# Card provider: "mock" (in-memory, no accounts needed) or "miden". Unset: miden if MIDEN_CLIENT_ID is set, else mock. See docs/card-providers.md.
CARD_PROVIDER=

# Miden (only when CARD_PROVIDER=miden)
MIDEN_BASE_URL=https://sandbox-api.midencards.io/miden
MIDEN_TOKEN_URL=https://sandbox-identityserver.midencards.io/connect/token
MIDEN_CLIENT_ID=
MIDEN_CLIENT_SECRET=
MIDEN_UNIQUE_KEY=
# Webhook validation hash (alphanumeric): HMAC key for x-signature (src/lib/clients/cardIssuing/miden/webhookSignature.ts). Used by scripts/webhook-*.ts.
MIDEN_WEBHOOK_HASH=

# Production (real money). APP_ENV=production is the only way to use a non-sandbox Miden host. It then requires
# CARD_PROVIDER=miden, https MIDEN_BASE_URL and MIDEN_TOKEN_URL (no defaults), and refuses to start if
# ALLOW_SIMULATED_DEPOSITS=1 or SWAP_STRIPE_TEST_CARD=1 is set. Leave ALLOW_SIMULATED_DEPOSITS unset in production.
APP_ENV=
ALLOW_SIMULATED_DEPOSITS=
# Low-balance alert on the Miden USD wallet (top-ups are paid from it). Dollars; default 100 in production, off in sandbox.
MIDEN_WALLET_MIN_USD=
# Optional: a Slack-compatible webhook that gets `{ text }` when the wallet goes low, recovers, or cannot be read.
ALERT_WEBHOOK_URL=
# Alerts through the same webhook: Circle webhook 5xx, Circle catch-up reconcile errors, top-ups stuck in 'reserved'.
# Minutes a top-up may sit in 'reserved' before it counts as stuck (default 15).
STUCK_FUNDING_MINUTES=

# Full reference: docs/configuration.md. Nothing loads this file automatically: `node --env-file=.env ...`.

# Server
# PORT=8787
# HOST=127.0.0.1
# Public URL of the service (used in links it hands out)
# PUBLIC_URL=http://127.0.0.1:8787
# Extra Host headers to accept (comma separated), e.g. a tunnel or your domain
# ALLOWED_HOSTS=
# Hosts that may reach only /webhooks/* (a tunnel for Circle webhooks); not also in ALLOWED_HOSTS
# WEBHOOK_ONLY_HOSTS=

# Circle deposit rail (optional; docs/circle-deposits.md). Set CIRCLE_API_KEY and CIRCLE_ENTITY_SECRET together or not at all.
# Sandbox: a TEST_API_KEY:... key. `pnpm exec tsx scripts/circle-setup.ts wallet-set` prints a wallet set id.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
# Default BASE-SEPOLIA. BASE (mainnet) also needs CIRCLE_LIVE=1 and a live key.
CIRCLE_NETWORK=
CIRCLE_LIVE=

# Postgres for the ledger (tests run the Postgres suite when set; skipped otherwise).
# scripts/sandbox-up.sh sets this for you from Docker or Homebrew when it is unset.
DATABASE_URL=
# Base RPC for the chain watchers and payouts (default: a public Base Sepolia endpoint)
# BASE_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=
# Derived-address deposit watchers. Off when Circle is on; 1 keeps them for older addresses.
# CHAIN_WATCHER=
# Where the HD deposit wallet seed is kept (default .sandbox-wallet.json; git-ignored, back it up)
# DEPOSIT_WALLET_FILE=
# Seconds a new payout address waits before it can receive a payout (default 600)
# PAYOUT_ADDRESS_DELAY_S=

# Card vault (src/adapters/cardVault/CardVault.ts): 32 random bytes, base64 (openssl rand -base64 32). Losing it loses every vaulted card.
CARD_VAULT_KEY=

# Checkout swap (docs/checkout-swap.md): agents pay hosted Stripe checkouts with the vaulted card. Off unless 1.
SWAP_ENABLED=
# Hard cap per swap, cents. $10 until a live test passes.
SWAP_MAX_CENTS=1000
SWAP_ALLOWED_HOSTS=checkout.stripe.com,buy.stripe.com
SWAP_RECEIPT_EMAIL=
# Let a model map unfamiliar checkout forms (needs ANTHROPIC_API_KEY; SWAP_AI_FILL=0 turns it off, SWAP_AI_MODEL picks the model)
# ANTHROPIC_API_KEY=
# SWAP_AI_FILL=
# SWAP_AI_MODEL=
# Sandbox only: pay Stripe test-mode links with the Stripe test card, and exact hosts of local test shops
# SWAP_STRIPE_TEST_CARD=
# SWAP_TEST_HOSTS=
# Hosts allowed over plain http (a local test shop only)
# SWAP_INSECURE_HOSTS=
# Other public https checkouts, paid with a one-time card only
# SWAP_OPEN_HOSTS=
